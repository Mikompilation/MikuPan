/*
 * The options screen, in the manner of MioPan's menus and the look of Fatal
 * Frame: a single column centred on the PS2's 640x448, the title and the
 * sections at the top, the rows between two rules, help and button prompts
 * below.
 *
 * The palette is an old photograph's -- sepia text over black, the warm gold
 * of the title menu's dividers -- with the umber bar of that menu as the
 * cursor, and the PS2 options screen's roll of film across the top.  Film
 * grain lies over everything, as it does over the game.
 *
 *   ink        #e8ddc7   aged paper: text
 *   ink-dim    #a39885   ash: help, notes
 *   ink-off    #5d554b   disabled
 *   void       #050403   the deepest black
 *   panel      #080605   floating panels
 *   lacquer    #14100c   keys and buttons at rest
 *   slot       #1a140e   wells: slider tracks
 *   gold-dim   #5b4b33   frames and rules at rest
 *   gold       #b39360   frames
 *   gold-hot   #e0c080   a frame with the cursor
 *   amber      #d9a85a   the cursor, a value being changed
 *   candle     #f0c060   a value waiting to be applied, warnings
 *
 * Sizes are in dp, and one dp is one pixel of the PS2's 640x448 screen
 * scaled to the game picture (mikupan_rmlui.cpp), so a layout here is a
 * layout on the original screen.
 */

body
{
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: MikuPanRml;
    font-size: 13dp;
    color: #e8ddc7;
}

body.font-zapf
{
    font-family: MikuPanRmlZapf;
}

div, p, h1, h2
{
    display: block;
}

.hidden
{
    display: none;
}

/* Over the game: a dark wash, darker at the edges, and grain on top. */
#backdrop
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #050403c0;
    decorator: image(images/vignette.png), image(images/grain.png repeat);
}

body.ingame #backdrop
{
    background-color: #050403b0;
}

/* While a side panel is open the room behind has to be seen as it is. */
body.panel-open #backdrop
{
    display: none;
}

.rule
{
    height: 6dp;
    decorator: image(images/rule.png);
}

/* ---- the frame --------------------------------------------------------- */

#frame
{
    position: absolute;
    left: 50%;
    top: 16dp;
    bottom: 14dp;
    width: 540dp;
    margin-left: -270dp;
    /* A fade rather than a rise: a transform on an ancestor would make
     * RmlUi clip the scrolling rows with a mask, which the backend does not
     * draw. */
    animation: 0.2s quadratic-out fade-in;
}

body.panel-open #frame,
body.panel-open #film
{
    display: none;
}

/* The roll of film the PS2 options screen had across its top -- the mode
 * select's strip and canister, where the game puts them (46,18 to 594,88)
 * -- with the title written on it, as the Load screen has it. */
#film
{
    position: absolute;
    left: 50%;
    top: 18dp;
    width: 548dp;
    height: 70dp;
    margin-left: -274dp;
    animation: 0.2s quadratic-out fade-in;
}

#film-strip
{
    position: absolute;
    display: block;
    left: 0;
    top: 0;
    width: 548dp;
    height: 70dp;
}

#film-strip.hidden
{
    display: none;
}

#title
{
    position: absolute;
    display: block;
    left: 43dp;
    top: 6dp;
    width: 505dp;
    height: 54dp;
    margin: 0;
    font-family: MikuPanRmlZapf;
    font-size: 27dp;
    font-weight: normal;
    line-height: 54dp;
    letter-spacing: 3dp;
    text-align: center;
    text-transform: uppercase;
    white-space: nowrap;
    color: #f7ecb6;
    font-effect: glow(4px 14px 0px 0px #7f481f78), glow(2px 7px 0px 0px #c77d3598), glow(1px 3px 0px 0px #f0bb5bb0);
}

/* ---- sections ---------------------------------------------------------- */

/* Just under the film. */
#tabs
{
    position: absolute;
    left: 0;
    right: 0;
    top: 74dp;
    height: 20dp;
    white-space: nowrap;
}

.tab
{
    display: inline-block;
    padding: 0 6dp;
    height: 18dp;
    line-height: 18dp;
    font-size: 10.5dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: #8f8678;
    border-bottom: 2dp #00000000;
    cursor: pointer;
}

.tab:hover
{
    color: #ddd2bd;
}

.tab.active
{
    color: #fff4dc;
    border-bottom-color: #d9a85a;
    font-effect: glow(0dp 3dp 0dp 0dp #c77d3566);
}

#rule-top
{
    position: absolute;
    left: -10dp;
    right: -10dp;
    top: 95dp;
}

/* ---- rows -------------------------------------------------------------- */

#pages
{
    position: absolute;
    left: 0;
    right: 0;
    top: 104dp;
    bottom: 66dp;
    overflow-y: auto;
}

.page
{
    padding-right: 8dp;
    padding-bottom: 4dp;
}

.heading
{
    margin: 10dp 0 3dp 0;
    padding: 0 0 1dp 2dp;
    font-size: 9.5dp;
    letter-spacing: 2dp;
    text-transform: uppercase;
    color: #c7a66e;
    border-bottom: 1dp #5b4b3388;
}

.note
{
    margin: 4dp 0 6dp 0;
    padding: 0 0 0 12dp;
    font-size: 11dp;
    line-height: 14dp;
    color: #f0c060;
}

.row
{
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 19dp;
    line-height: 19dp;
    padding: 0 10dp;
    border-left: 2dp #00000000;
    cursor: pointer;
}

.row.selected
{
    border-left-color: #d9a85a;
    decorator: image(images/cursor_glow.png);
    color: #fff4dc;
}

.row.disabled
{
    color: #5d554b;
}

.row.disabled.selected
{
    border-left-color: #5b4b33;
}

.row-label
{
    font-size: 13dp;
    white-space: nowrap;
}

.row-value
{
    display: flex;
    align-items: center;
    justify-content: flex-end;
    width: 236dp;
    font-size: 12dp;
    color: #cfc5b4;
}

.row.selected .row-value
{
    color: #fff4dc;
}

.row.disabled .row-value
{
    color: #5d554b;
}

.value
{
    display: inline-block;
    min-width: 54dp;
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
}

.choice .value
{
    width: 180dp;
}

/* A display change that waits for Enter: the candle colour until it is
 * applied. */
.row.pending .value
{
    color: #f0c060;
}

.slider .value
{
    width: 64dp;
    text-align: right;
    padding-right: 4dp;
}

.action-value
{
    padding: 0 12dp;
    border: 1dp #5b4b33;
    background-color: #14100c;
    line-height: 15dp;
    font-size: 10.5dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
}

.row.selected .action-value
{
    border-color: #e0c080;
    background-color: #3a2a14;
}

.row.disabled .action-value
{
    border-color: #2a2219;
    background-color: #0d0a08;
}

/* A path or other long text an action acts on: shown, not boxed. */
.action-value.plain
{
    max-width: 220dp;
    padding: 0 2dp;
    border-width: 0;
    background-color: transparent;
    letter-spacing: 0;
    text-transform: none;
    font-size: 11dp;
    text-align: right;
}

.row.selected .action-value.plain
{
    background-color: transparent;
}

/* A binding: the key or button it holds, on a key cap. */
.binding-value
{
    width: 200dp;
    padding: 0 8dp;
    border: 1dp #5b4b33;
    background-color: #14100c;
    line-height: 15dp;
    font-size: 11dp;
}

.row.selected .binding-value
{
    border-color: #e0c080;
    background-color: #3a2a14;
}

.row.unbound .binding-value
{
    color: #7a7062;
}

/* The step arrows: dim at rest, lit on the cursor's row. */
.arrow
{
    display: inline-block;
    width: 14dp;
    text-align: center;
    font-size: 15dp;
    color: #5b4b33;
    cursor: pointer;
}

.row.selected .arrow
{
    color: #d9a85a;
}

.row.disabled .arrow,
.row.disabled.selected .arrow
{
    color: #2a2219;
}

.arrow:hover
{
    color: #fff4dc;
}

/* A slider: a well with the umber fill inside it, and a tick where the
 * setting sits by default. */
.track
{
    display: inline-block;
    position: relative;
    width: 112dp;
    height: 5dp;
    margin: 0 4dp;
    background-color: #1a140e;
    border: 1dp #5b4b33;
}

.fill
{
    display: block;
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 0%;
    background-color: #8a6a3a;
}

.row.selected .fill
{
    background-color: #d9a85a;
}

.row.disabled .fill
{
    background-color: #2a2219;
}

.mark
{
    display: block;
    position: absolute;
    top: -2dp;
    bottom: -2dp;
    width: 1dp;
    background-color: #c7a66e99;
}

/* ---- help and prompts -------------------------------------------------- */

#rule-bottom
{
    position: absolute;
    left: -10dp;
    right: -10dp;
    bottom: 56dp;
}

#help
{
    position: absolute;
    left: 4dp;
    right: 4dp;
    bottom: 20dp;
    height: 32dp;
    font-size: 11.5dp;
    line-height: 15dp;
    color: #a39885;
}

#prompts
{
    position: absolute;
    right: 0;
    bottom: 0;
    height: 14dp;
}

.prompts
{
    text-align: right;
    font-size: 10.5dp;
    line-height: 14dp;
    color: #8f8678;
    white-space: nowrap;
}

.prompt
{
    display: inline-block;
    margin-left: 14dp;
    cursor: pointer;
}

.prompt:hover
{
    color: #e8ddc7;
}

.key
{
    display: inline-block;
    padding: 0 4dp;
    margin-right: 4dp;
    border: 1dp #5b4b33;
    background-color: #14100c;
    color: #e8ddc7;
    font-size: 9.5dp;
    line-height: 12dp;
}

/* ---- the side panel (calibration, CRT) -------------------------------- */

/* Both panels keep to the PS2's screen in the middle of the picture, however
 * wide it is. */
#panel
{
    position: absolute;
    left: 50%;
    margin-left: -300dp;
    top: 20dp;
    width: 312dp;
    padding: 10dp 12dp 8dp 12dp;
    background-color: #080605e0;
    border: 1dp #5b4b33;
    animation: 0.15s quadratic-out fade-in;
}

#panel.hidden
{
    display: none;
}

#panel-title
{
    margin: 0 0 4dp 0;
    font-family: MikuPanRmlZapf;
    font-size: 19dp;
    font-weight: normal;
    line-height: 24dp;
    letter-spacing: 1dp;
    color: #f7ecb6;
    font-effect: glow(2px 7px 0px 0px #c77d3570), glow(1px 3px 0px 0px #f0bb5b90);
}

#panel .rule
{
    height: 1dp;
    margin: 2dp 0;
    decorator: horizontal-gradient(#b39360cc #b3936000);
}

#panel-rows
{
    max-height: 292dp;
    padding: 4dp 0;
    overflow-y: auto;
}

#panel .row
{
    padding: 0 6dp;
}

#panel .row-label
{
    font-size: 12dp;
}

#panel .row-value
{
    width: 168dp;
    font-size: 11dp;
}

#panel .choice .value
{
    width: 120dp;
}

#panel .track
{
    width: 72dp;
}

#panel .slider .value
{
    width: 48dp;
}

#panel-help
{
    min-height: 28dp;
    margin: 6dp 0 4dp 0;
    font-size: 10.5dp;
    line-height: 14dp;
    color: #a39885;
}

#panel-prompts
{
    height: 14dp;
}

/* The grey ramp beside the calibration panel: every step should be told
 * from its neighbours, the first from black, the last from white. */
#levels
{
    position: absolute;
    left: 50%;
    margin-left: 122dp;
    bottom: 20dp;
    width: 156dp;
    padding: 8dp 10dp 7dp 10dp;
    background-color: #080605e0;
    border: 1dp #5b4b33;
}

#levels.hidden
{
    display: none;
}

#levels-title
{
    margin: 0 0 4dp 0;
    font-size: 10dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: #c7a66e;
}

#levels-strip
{
    display: flex;
    width: 136dp;
    height: 18dp;
    border: 1dp #5b4b33;
    background-color: #000000;
}

.level
{
    display: block;
    flex: 1;
    height: 18dp;
    background-color: #000000;
}

#levels-labels
{
    display: flex;
    justify-content: space-between;
    width: 136dp;
    margin-top: 3dp;
    font-size: 8dp;
    letter-spacing: 1dp;
    text-transform: uppercase;
    color: #9a8f7f;
}

/* ---- the yes / no window ---------------------------------------------- */

#confirm
{
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #05040399;
}

#confirm.hidden
{
    display: none;
}

#confirm-box
{
    position: absolute;
    left: 50%;
    top: 50%;
    width: 320dp;
    margin-left: -160dp;
    margin-top: -52dp;
    padding: 16dp 20dp 14dp 20dp;
    background-color: #0a0807f5;
    border: 1dp #b39360;
    text-align: center;
    animation: 0.15s quadratic-out fade-in;
}

#confirm-text
{
    margin-bottom: 4dp;
    font-size: 14dp;
    line-height: 18dp;
}

#confirm-note
{
    margin-bottom: 14dp;
    font-size: 11dp;
    line-height: 14dp;
    color: #f0c060;
}

#confirm-note.hidden
{
    display: none;
}

#confirm-choices
{
    text-align: center;
}

#confirm-choices.hidden
{
    display: none;
}

.confirm-choice
{
    display: inline-block;
    width: 76dp;
    margin: 0 8dp;
    padding: 2dp 0;
    line-height: 18dp;
    text-align: center;
    cursor: pointer;
}

/* Centred, so the bar that fades both ways. */
.confirm-choice.selected
{
    color: #fff4dc;
    decorator: image(images/cursor_bar.png);
    font-effect: glow(0dp 3dp 0dp 0dp #c77d3566);
}

/* ---- scrolling -------------------------------------------------------- */

scrollbarvertical
{
    width: 3dp;
    margin-left: 4dp;
}

scrollbarvertical slidertrack
{
    background-color: #14100c;
}

scrollbarvertical sliderbar
{
    min-height: 16dp;
    background-color: #5b4b33;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active
{
    background-color: #e0c080;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc
{
    width: 0;
    height: 0;
}

@keyframes fade-in
{
    from { opacity: 0; }
    to   { opacity: 1; }
}
