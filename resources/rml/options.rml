<rml>
<head>
    <title>Options</title>
    <link type="text/rcss" href="options.rcss"/>
</head>
<body id="options">
    <div id="backdrop"></div>
    <!-- The mode select's own film strip and canister, as the options screen
         had them on the PS2: built from the disc by mikupan_rml_save_load.cpp
         and shared with the Load screen. -->
    <div id="film">
        <img id="film-strip" class="hidden" />
        <h1 id="title">Options</h1>
    </div>
    <div id="frame">
        <!-- Sections and their rows are built by mikupan_rml_options.cpp. -->
        <div id="tabs"></div>
        <div class="rule" id="rule-top"></div>
        <div id="pages"></div>
        <div class="rule" id="rule-bottom"></div>
        <p id="help"></p>
        <div id="prompts" class="prompts"></div>
    </div>

    <!-- Calibration and the CRT filter: a narrow panel at the side, with the
         room left in view behind it. -->
    <div id="panel" class="hidden">
        <h2 id="panel-title"></h2>
        <div class="rule"></div>
        <div id="panel-rows"></div>
        <div class="rule"></div>
        <p id="panel-help"></p>
        <div id="panel-prompts" class="prompts"></div>
    </div>
    <div id="levels" class="hidden">
        <p id="levels-title">Grey Levels</p>
        <div id="levels-strip">
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
            <span class="level"></span><span class="level"></span>
        </div>
        <div id="levels-labels">
            <span id="levels-black">Black</span>
            <span id="levels-white">White</span>
        </div>
    </div>

    <!-- Yes / No, the display countdown, and binding capture. -->
    <div id="confirm" class="hidden">
        <div id="confirm-box">
            <p id="confirm-text"></p>
            <p id="confirm-note"></p>
            <div id="confirm-choices">
                <span id="confirm-yes" class="confirm-choice">Yes</span>
                <span id="confirm-no" class="confirm-choice">No</span>
            </div>
        </div>
    </div>
</body>
</rml>
